# Supabase Postgres connection used only by the server and migration commands.
DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# Browser-safe Supabase settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Invoice delivery.
RESEND_API_KEY=re_xxxxxxxxx
INVOICE_FROM_EMAIL=HFY Billing <billing@hearforyou.group>
INVOICE_REPLY_TO=billing@hearforyou.group
INVOICE_BUSINESS_NAME=Hear For You
INVOICE_BUSINESS_EMAIL=billing@hearforyou.group
# Optional. Use line breaks when a complete remittance address is available.
INVOICE_BUSINESS_ADDRESS=

# Optional local-only override. Vercel uses the bundled serverless Chromium binary.
INVOICE_CHROME_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Vercel sends this as Authorization: Bearer <value> for Cron requests.
CRON_SECRET=replace-with-at-least-32-random-characters

# Server-only Healthchecks.io success-ping URLs. Each handler pings only after
# its automation finishes successfully, so missing or failed runs remain visible.
HEALTHCHECKS_AUTO_COMPLETE_URL=https://hc-ping.com/replace-with-check-uuid
HEALTHCHECKS_RECONCILE_URL=https://hc-ping.com/replace-with-check-uuid

# Sentry error monitoring. The DSN is browser-safe; the auth token is build-only
# and must remain a Vercel server secret for source-map uploads.
NEXT_PUBLIC_SENTRY_DSN=https://public-key@o0.ingest.sentry.io/project-id
SENTRY_ORG=your-sentry-organization-slug
SENTRY_PROJECT=hfy-os
SENTRY_AUTH_TOKEN=sntrys_replace-with-project-source-map-token
SENTRY_ENVIRONMENT=production

NEXT_PUBLIC_APP_URL=http://localhost:3000
