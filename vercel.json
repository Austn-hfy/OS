{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm exec tsx scripts/apply-one-time-session-rate-migration.ts && pnpm build",
  "git": {
    "deploymentEnabled": {
      "codex/performance-pdx1-region": false,
      "codex/performance-supabase-lifecycle": false
    }
  },
  "regions": ["pdx1"],
  "crons": [
    {
      "path": "/api/cron/auto-complete",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/reconcile",
      "schedule": "15 12 * * *"
    }
  ]
}
