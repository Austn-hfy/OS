{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "outcome": {
      "type": "string",
      "enum": ["fixed", "needs_human", "not_actionable"]
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "summary": {
      "type": "string"
    },
    "root_cause": {
      "type": "string"
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_action": {
      "type": "string"
    }
  },
  "required": [
    "outcome",
    "confidence",
    "summary",
    "root_cause",
    "validation",
    "changed_files",
    "human_action"
  ]
}
